WHITESPACE = _{ " " | "\t" }

program = { SOI ~ gap* ~ section ~ (gap+ ~ section)* ~ gap* ~ EOI }
section = _{ variable_block | exercise_block }
gap = _{ NEWLINE }

variable_block = { "Variables" ~ ":" ~ NEWLINE ~ variable_decl ~ (NEWLINE ~ variable_decl)* }
variable_decl = { identifier ~ "=" ~ value_expr }

exercise_block = { exercise_header ~ NEWLINE ~ property ~ (NEWLINE ~ property)* }
exercise_header = { exercise_name ~ ":" }
exercise_name = @{ (!":" ~ !NEWLINE ~ ANY)+ }

property = _{ load_prop | grade_prop | volume_prop }
load_prop = { "Load" ~ ":" ~ load_expr }
grade_prop = { "Grade" ~ ":" ~ grade_val }
volume_prop = { "Volume" ~ ":" ~ volume_expr }

load_expr = { load_term ~ (load_op ~ load_term)* }
load_term = { pct_ref | identifier | literal_val }
pct_ref = { number ~ "%" ~ identifier }
literal_val = { sign? ~ number ~ unit? }
load_op = { "+" | "-" | "*" | "/" }

volume_expr = { time_volume | rep_volume }
time_volume = { duration ~ "hang" ~ "," ~ duration ~ "rest" ~ "x" ~ number ~ "sets" }
rep_volume = { number ~ rep_keyword ~ ("," ~ rpe_clause)? }
rep_keyword = { "attempts" | "reps" }
rpe_clause = { "RPE" ~ number }
duration = { number ~ time_unit }
time_unit = { "s" | "sec" | "m" | "min" }

grade_val = { v_grade | font_grade }
v_grade = @{ "V" ~ ASCII_DIGIT+ }
font_grade = @{ ASCII_DIGIT+ ~ ("a" | "b" | "c")? ~ ("+" | "-")? }

value_expr = { sign? ~ number ~ unit? ~ rate? }
sign = { "+" | "-" }
unit = { "lbs" | "kg" | "lb" }
rate = { "/" ~ rate_period }
rate_period = { "week" | "session" | "month" }

identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
number = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
NEWLINE = @{ "\r"? ~ "\n" }
